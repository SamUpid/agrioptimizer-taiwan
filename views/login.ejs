<div class="auth-wrapper">
  <div class="auth-card">

    <div class="auth-logo">
      <span class="auth-logo-icon">🌿</span>
      <span class="auth-logo-name">AgroOptimizer Taiwan</span>
      <span class="auth-logo-zh">農業優化系統</span>
    </div>

    <h1 class="auth-title">Welcome back 歡迎回來</h1>
    <p class="auth-subtitle">Sign in to your farm profile · 登入您的農場帳戶</p>

    <% if (error_msg && error_msg.length > 0) { %>
      <% error_msg.forEach(msg => { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <i class="bi bi-exclamation-triangle-fill me-2"></i><%= msg %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% }); %>
    <% } %>

    <% if (success_msg && success_msg.length > 0) { %>
      <% success_msg.forEach(msg => { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <i class="bi bi-check-circle-fill me-2"></i><%= msg %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% }); %>
    <% } %>

    <form action="/auth/login" method="POST">
      <div class="mb-3">
        <label for="email" class="form-label">Email Address 電子郵件</label>
        <input type="email" id="email" name="email"
               class="form-control"
               placeholder="your@email.com"
               required autocomplete="email">
      </div>

      <div class="mb-3">
        <label for="password" class="form-label">Password 密碼</label>
        <input type="password" id="password" name="password"
               class="form-control"
               placeholder="••••••••"
               required autocomplete="current-password">
      </div>

      <button type="submit" class="btn-auth">
        <i class="bi bi-box-arrow-in-right me-2"></i>Sign In 登入
      </button>
    </form>

    <div class="auth-divider">or 或者</div>

    <div class="auth-switch">
      Don't have an account?
      <a href="/auth/signup">Sign up free 免費註冊</a>
    </div>

    <div class="auth-switch mt-2">
      <a href="/location">Try without login 免登入體驗 →</a>
    </div>

  </div>
</div>
