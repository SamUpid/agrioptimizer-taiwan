<!-- Breadcrumb Navigation -->
<nav aria-label="breadcrumb" class="container mt-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/"><%= __('nav.home') %></a></li>
    <li class="breadcrumb-item active" aria-current="page"><%= __('nav.location') %></li>
  </ol>
</nav>

<div class="container my-4">
  <div class="row mb-4">
    <div class="col-12 text-center">
      <h1 class="display-5 fw-bold text-success">
        <i class="bi bi-geo-alt-fill me-2"></i><%= __('location.title') %>
      </h1>
      <p class="lead text-muted"><%= __('location.subtitle') %></p>
    </div>
  </div>

  <div id="alertContainer"></div>

  <div class="row">
    <div class="col-lg-8 mb-4">
      <div class="card shadow-sm mb-3">
        <div class="card-body">
          <h5 class="card-title mb-3"><i class="bi bi-search me-2 text-success"></i><%= __('common.search') %></h5>
          <div class="input-group mb-3">
            <input type="text" id="searchInput" class="form-control form-control-lg" placeholder="<%= __('location.searchPlaceholder') %>" autocomplete="off">
            <button class="btn btn-success btn-lg" type="button" id="searchButton">
              <i class="bi bi-search me-1"></i><%= __('common.search') %>
            </button>
          </div>
          <button class="btn btn-outline-success w-100" id="useMyLocationBtn">
            <i class="bi bi-geo-alt me-2"></i><%= __('location.currentLocation') %>
          </button>
        </div>
      </div>
      <div class="card shadow-sm">
        <div class="card-body p-0">
          <div id="map" style="height:500px;width:100%;border-radius:8px 8px 0 0;"></div>
        </div>
        <div class="card-footer text-muted small">
          <i class="bi bi-info-circle me-1"></i><%= __('location.mapHelp') %>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card shadow-sm mb-3 border-0 bg-light">
        <div class="card-body">
          <h6 class="card-title text-success fw-bold"><i class="bi bi-info-circle me-2"></i><%= __('location.howToUse') %></h6>
          <ol class="mb-0 small text-muted">
            <li><%= __('location.step1') %></li>
            <li><%= __('location.step2') %></li>
            <li><%= __('location.step3') %></li>
            <li><%= __('location.step4') %></li>
          </ol>
        </div>
      </div>

      <div class="card shadow-sm mb-3" id="locationCard" style="display:none;">
        <div class="card-header bg-success text-white">
          <h5 class="mb-0"><i class="bi bi-check-circle me-2"></i><%= __('location.selectedLocation') %></h5>
        </div>
        <div class="card-body">
          <div class="mb-2">
            <label class="form-label fw-bold small text-muted"><i class="bi bi-house-door me-1"></i><%= __('location.addressLabel') %></label>
            <p id="selectedAddress" class="mb-0 small">-</p>
          </div>
          <div class="mb-2">
            <label class="form-label fw-bold small text-muted"><i class="bi bi-geo me-1"></i><%= __('location.coordLabel') %></label>
            <p id="selectedCoordinates" class="mb-0 font-monospace small">-</p>
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold small text-muted"><i class="bi bi-triangle me-1"></i><%= __('location.elevation') %></label>
            <p id="selectedElevation" class="mb-1"><span class="badge bg-success fs-6">- m</span></p>
            <div id="elevationHint"></div>
          </div>
          <div class="d-grid gap-2">
            <button class="btn btn-success btn-lg" id="confirmLocationBtn">
              <i class="bi bi-check-lg me-2"></i><%= __('location.confirm') %>
            </button>
            <button class="btn btn-outline-secondary btn-sm" id="clearLocationBtn">
              <i class="bi bi-x-lg me-2"></i><%= __('common.clear') %>
            </button>
          </div>
        </div>
      </div>

      <div class="card shadow-sm">
        <div class="card-header">
          <h6 class="mb-0"><i class="bi bi-pencil me-2"></i><%= __('location.manualEntry') %></h6>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <label for="manualLat" class="form-label small"><%= __('location.latitude') %></label>
            <input type="number" class="form-control" id="manualLat" placeholder="23.5" step="0.000001" min="21" max="26">
            <div class="form-text">21.5 - 26.0 (Taiwan)</div>
          </div>
          <div class="mb-3">
            <label for="manualLng" class="form-label small"><%= __('location.longitude') %></label>
            <input type="number" class="form-control" id="manualLng" placeholder="121.0" step="0.000001" min="119" max="122.5">
            <div class="form-text">119.0 - 122.5 (Taiwan)</div>
          </div>
          <button class="btn btn-outline-success w-100" id="manualFetchBtn">
            <i class="bi bi-download me-2"></i><%= __('location.fetchElevationBtn') %>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="row mt-4" id="nextStepSection" style="display:none;">
    <div class="col-12">
      <div class="card border-success shadow">
        <div class="card-body text-center py-4">
          <h5 class="text-success mb-1"><i class="bi bi-check-circle-fill me-2"></i><%= __('flash.locationSaved') %></h5>
          <p class="text-muted mb-3"><%= __('location.readyMessage') %></p>
          <a href="/climate" class="btn btn-success btn-lg px-5">
            <%= __('location.next') %> <i class="bi bi-arrow-right ms-2"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="loadingOverlay" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:9999;align-items:center;justify-content:center;">
  <div class="text-center">
    <div class="spinner-border text-light" role="status" style="width:3rem;height:3rem;"></div>
    <p class="text-light mt-3 fw-bold"><%= __('common.loading') %></p>
  </div>
</div>

<script>
let map;
let marker;
let geocoder;
let currentLocation = null;
let autocomplete;

// Initialize map
function initMap() {
  const defaultLocation = { lat: 23.5, lng: 121.0 };
  
  map = new google.maps.Map(document.getElementById("map"), {
    center: defaultLocation,
    zoom: 8,
    styles: [
      {
        featureType: "poi",
        elementType: "labels",
        stylers: [{ visibility: "off" }]
      }
    ]
  });
  
  geocoder = new google.maps.Geocoder();
  
  // Create marker
  marker = new google.maps.Marker({
    map: map,
    draggable: true,
    animation: google.maps.Animation.DROP
  });
  
  // Listen for marker drag end
  marker.addListener("dragend", () => {
    const position = marker.getPosition();
    updateLocation(position.lat(), position.lng());
  });
  
  // Listen for map click
  map.addListener("click", (event) => {
    placeMarker(event.latLng);
  });
  
  // Setup autocomplete for search
  const searchInput = document.getElementById("searchInput");
  autocomplete = new google.maps.places.Autocomplete(searchInput);
  autocomplete.bindTo("bounds", map);
  
  autocomplete.addListener("place_changed", () => {
    const place = autocomplete.getPlace();
    if (!place.geometry || !place.geometry.location) {
      console.error("No location data available");
      return;
    }
    
    map.setCenter(place.geometry.location);
    map.setZoom(15);
    placeMarker(place.geometry.location);
  });
  
  // Load saved location from session
  loadSavedLocation();
}

// Load saved location from server
async function loadSavedLocation() {
  try {
    const response = await fetch('/location/current');
    const data = await response.json();
    
    if (data.success && data.hasLocation && data.data) {
      const location = data.data;
      setTimeout(() => {
        placeMarker({ lat: location.lat, lng: location.lng });
        showAlert('Loaded your saved location', 'info');
      }, 1000);
    }
  } catch (error) {
    console.error('Error loading saved location:', error);
  }
}

// Place marker and update location
function placeMarker(location) {
  marker.setPosition(location);
  map.setCenter(location);
  updateLocation(location.lat(), location.lng());
}

// Update location information using server APIs
async function updateLocation(lat, lng) {
  currentLocation = { lat, lng };
  
  // Update coordinates display
  document.getElementById("selectedCoordinates").innerHTML = `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
  
  // Get address using server reverse geocode
  try {
    const response = await fetch('/location/reverse-geocode', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ lat, lng })
    });
    
    const data = await response.json();
    if (data.success) {
      document.getElementById("selectedAddress").innerHTML = data.data.address;
    } else {
      document.getElementById("selectedAddress").innerHTML = "Address not found";
    }
  } catch (error) {
    console.error("Error getting address:", error);
    document.getElementById("selectedAddress").innerHTML = "Unable to fetch address";
  }
  
  // Get elevation using server API
  try {
    const response = await fetch('/location/fetch-elevation', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ lat, lng })
    });
    
    const data = await response.json();
    if (data.success && data.data.elevation) {
      const elevationMeters = Math.round(data.data.elevation);
      document.getElementById("selectedElevation").innerHTML = `<span class="badge bg-success fs-6">${elevationMeters} m</span>`;
      
      // Show elevation hint
      const hintDiv = document.getElementById("elevationHint");
      if (elevationMeters > 800) {
        hintDiv.innerHTML = '<small class="text-success"><i class="bi bi-stars"></i> Excellent for specialty coffee & high-mountain tea</small>';
      } else if (elevationMeters > 400) {
        hintDiv.innerHTML = '<small class="text-info"><i class="bi bi-flower2"></i> Good for tea, fruits, and vegetables</small>';
      } else {
        hintDiv.innerHTML = '<small class="text-warning"><i class="bi bi-sun"></i> Suitable for vegetables and tropical fruits</small>';
      }
    }
  } catch (error) {
    console.error("Error fetching elevation:", error);
  }
  
  // Show location card
  document.getElementById("locationCard").style.display = "block";
}

// Confirm location - Save to server
document.getElementById("confirmLocationBtn")?.addEventListener("click", async () => {
  if (!currentLocation) {
    showAlert("Please select a location on the map first", "warning");
    return;
  }
  
  // Show loading overlay
  document.getElementById("loadingOverlay").style.display = "flex";
  
  try {
    const address = document.getElementById("selectedAddress").innerHTML;
    const elevationText = document.getElementById("selectedElevation").innerHTML;
    const elevationMatch = elevationText.match(/(\d+)\s*m/);
    const elevation = elevationMatch ? parseInt(elevationMatch[1]) : null;
    
    // Save to server using your existing endpoint
    const response = await fetch("/location/save", {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        lat: currentLocation.lat,
        lng: currentLocation.lng,
        address: address !== "-" ? address : null,
        elevation: elevation
      })
    });
    
    const data = await response.json();
    
    if (data.success) {
      showAlert("Location saved successfully!", "success");
      document.getElementById("nextStepSection").style.display = "block";
      document.getElementById("locationCard").style.border = "2px solid #28a745";
    } else {
      throw new Error(data.message || "Failed to save location");
    }
  } catch (error) {
    console.error("Error saving location:", error);
    showAlert(error.message || "Failed to save location. Please try again.", "danger");
  } finally {
    document.getElementById("loadingOverlay").style.display = "none";
  }
});

// Clear location
document.getElementById("clearLocationBtn")?.addEventListener("click", async () => {
  currentLocation = null;
  marker.setMap(null);
  marker = new google.maps.Marker({
    map: map,
    draggable: true,
    animation: google.maps.Animation.DROP
  });
  marker.addListener("dragend", () => {
    const position = marker.getPosition();
    updateLocation(position.lat(), position.lng());
  });
  document.getElementById("locationCard").style.display = "none";
  document.getElementById("nextStepSection").style.display = "none";
  
  // Clear from server
  try {
    await fetch("/location/clear", { method: "POST" });
    showAlert("Location cleared", "info");
  } catch (error) {
    console.error("Error clearing location:", error);
  }
});

// Use current location
document.getElementById("useMyLocationBtn")?.addEventListener("click", () => {
  if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition(
      (position) => {
        const pos = {
          lat: position.coords.latitude,
          lng: position.coords.longitude
        };
        map.setCenter(pos);
        placeMarker(pos);
      },
      (error) => {
        console.error("Geolocation error:", error);
        let message = "Unable to get your location.";
        if (error.code === 1) message = "Please allow location access.";
        if (error.code === 2) message = "Location unavailable.";
        if (error.code === 3) message = "Location request timed out.";
        showAlert(message, "warning");
      }
    );
  } else {
    showAlert("Geolocation is not supported by your browser", "danger");
  }
});

// Manual fetch elevation
document.getElementById("manualFetchBtn")?.addEventListener("click", async () => {
  const lat = parseFloat(document.getElementById("manualLat").value);
  const lng = parseFloat(document.getElementById("manualLng").value);
  
  if (isNaN(lat) || isNaN(lng)) {
    showAlert("Please enter valid latitude and longitude", "warning");
    return;
  }
  
  if (lat < 21 || lat > 26 || lng < 119 || lng > 122.5) {
    showAlert("Location must be in Taiwan (21-26°N, 119-122.5°E)", "warning");
    return;
  }
  
  document.getElementById("loadingOverlay").style.display = "flex";
  
  try {
    const response = await fetch('/location/fetch-elevation', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ lat, lng })
    });
    
    const data = await response.json();
    
    if (data.success && data.data.elevation) {
      const pos = { lat, lng };
      map.setCenter(pos);
      placeMarker(pos);
      showAlert(`Elevation: ${Math.round(data.data.elevation)}m`, "success");
    } else {
      showAlert(data.message || "Error fetching elevation data", "danger");
    }
  } catch (error) {
    console.error("Error:", error);
    showAlert("Error fetching elevation data", "danger");
  } finally {
    document.getElementById("loadingOverlay").style.display = "none";
  }
});

// Search button
document.getElementById("searchButton")?.addEventListener("click", async () => {
  const searchTerm = document.getElementById("searchInput").value;
  if (!searchTerm) {
    showAlert("Please enter a location to search", "warning");
    return;
  }
  
  document.getElementById("loadingOverlay").style.display = "flex";
  
  try {
    const response = await fetch('/location/geocode', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ address: searchTerm })
    });
    
    const data = await response.json();
    
    if (data.success) {
      const pos = { lat: data.data.lat, lng: data.data.lng };
      map.setCenter(pos);
      map.setZoom(15);
      placeMarker(pos);
      showAlert(`Found: ${data.data.address}`, "success");
    } else {
      showAlert(data.message || "Location not found. Please try again.", "warning");
    }
  } catch (error) {
    console.error("Search error:", error);
    showAlert("Error searching for location", "danger");
  } finally {
    document.getElementById("loadingOverlay").style.display = "none";
  }
});

// Helper function to show alerts
function showAlert(message, type) {
  const alertContainer = document.getElementById("alertContainer");
  const alertDiv = document.createElement("div");
  alertDiv.className = `alert alert-${type} alert-dismissible fade show`;
  alertDiv.innerHTML = `
    ${message}
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  `;
  alertContainer.appendChild(alertDiv);
  
  // Auto dismiss after 5 seconds
  setTimeout(() => {
    alertDiv.remove();
  }, 5000);
}
</script>