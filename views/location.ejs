<!-- Breadcrumb Navigation -->
<nav aria-label="breadcrumb" class="container mt-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/"><%= __('nav.home') %></a></li>
    <li class="breadcrumb-item active" aria-current="page"><%= __('nav.location') %></li>
  </ol>
</nav>

<div class="container my-4">
  <div class="row mb-4">
    <div class="col-12 text-center">
      <h1 class="display-5 fw-bold text-success">
        <i class="bi bi-geo-alt-fill me-2"></i><%= __('location.title') %>
      </h1>
      <p class="lead text-muted"><%= __('location.subtitle') %></p>
    </div>
  </div>

  <div id="alertContainer"></div>

  <div class="row">
    <div class="col-lg-8 mb-4">
      <div class="card shadow-sm mb-3">
        <div class="card-body">
          <h5 class="card-title mb-3"><i class="bi bi-search me-2 text-success"></i><%= __('common.search') %></h5>
          <div class="input-group mb-3">
            <input type="text" id="searchInput" class="form-control form-control-lg" placeholder="<%= __('location.searchPlaceholder') %>" autocomplete="off">
            <button class="btn btn-success btn-lg" type="button" id="searchButton">
              <i class="bi bi-search me-1"></i><%= __('common.search') %>
            </button>
          </div>
          <button class="btn btn-outline-success w-100" id="useMyLocationBtn">
            <i class="bi bi-geo-alt me-2"></i><%= __('location.currentLocation') %>
          </button>
        </div>
      </div>
      <div class="card shadow-sm">
        <div class="card-body p-0">
          <div id="map" style="height:500px;width:100%;border-radius:8px 8px 0 0;"></div>
        </div>
        <div class="card-footer text-muted small">
          <i class="bi bi-info-circle me-1"></i><%= __('location.mapHelp') %>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card shadow-sm mb-3 border-0 bg-light">
        <div class="card-body">
          <h6 class="card-title text-success fw-bold"><i class="bi bi-info-circle me-2"></i><%= __('location.howToUse') %></h6>
          <ol class="mb-0 small text-muted">
            <li><%= __('location.step1') %></li>
            <li><%= __('location.step2') %></li>
            <li><%= __('location.step3') %></li>
            <li><%= __('location.step4') %></li>
          </ol>
        </div>
      </div>

      <div class="card shadow-sm mb-3" id="locationCard" style="display:none;">
        <div class="card-header bg-success text-white">
          <h5 class="mb-0"><i class="bi bi-check-circle me-2"></i><%= __('location.selectedLocation') %></h5>
        </div>
        <div class="card-body">
          <div class="mb-2">
            <label class="form-label fw-bold small text-muted"><i class="bi bi-house-door me-1"></i><%= __('location.addressLabel') %></label>
            <p id="selectedAddress" class="mb-0 small">-</p>
          </div>
          <div class="mb-2">
            <label class="form-label fw-bold small text-muted"><i class="bi bi-geo me-1"></i><%= __('location.coordLabel') %></label>
            <p id="selectedCoordinates" class="mb-0 font-monospace small">-</p>
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold small text-muted"><i class="bi bi-triangle me-1"></i><%= __('location.elevation') %></label>
            <p id="selectedElevation" class="mb-1"><span class="badge bg-success fs-6">- m</span></p>
            <div id="elevationHint"></div>
          </div>
          <div class="d-grid gap-2">
            <button class="btn btn-success btn-lg" id="confirmLocationBtn">
              <i class="bi bi-check-lg me-2"></i><%= __('location.confirm') %>
            </button>
            <button class="btn btn-outline-secondary btn-sm" id="clearLocationBtn">
              <i class="bi bi-x-lg me-2"></i><%= __('common.clear') %>
            </button>
          </div>
        </div>
      </div>

      <div class="card shadow-sm">
        <div class="card-header">
          <h6 class="mb-0"><i class="bi bi-pencil me-2"></i><%= __('location.manualEntry') %></h6>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <label for="manualLat" class="form-label small"><%= __('location.latitude') %></label>
            <input type="number" class="form-control" id="manualLat" placeholder="23.5" step="0.000001" min="21" max="26">
            <div class="form-text">21.5 - 26.0 (Taiwan)</div>
          </div>
          <div class="mb-3">
            <label for="manualLng" class="form-label small"><%= __('location.longitude') %></label>
            <input type="number" class="form-control" id="manualLng" placeholder="121.0" step="0.000001" min="119" max="122.5">
            <div class="form-text">119.0 - 122.5 (Taiwan)</div>
          </div>
          <button class="btn btn-outline-success w-100" id="manualFetchBtn">
            <i class="bi bi-download me-2"></i><%= __('location.fetchElevationBtn') %>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="row mt-4" id="nextStepSection" style="display:none;">
    <div class="col-12">
      <div class="card border-success shadow">
        <div class="card-body text-center py-4">
          <h5 class="text-success mb-1"><i class="bi bi-check-circle-fill me-2"></i><%= __('flash.locationSaved') %></h5>
          <p class="text-muted mb-3"><%= __('location.readyMessage') %></p>
          <a href="/climate" class="btn btn-success btn-lg px-5">
            <%= __('location.next') %> <i class="bi bi-arrow-right ms-2"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="loadingOverlay" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:9999;align-items:center;justify-content:center;">
  <div class="text-center">
    <div class="spinner-border text-light" role="status" style="width:3rem;height:3rem;"></div>
    <p class="text-light mt-3 fw-bold"><%= __('common.loading') %></p>
  </div>
</div>