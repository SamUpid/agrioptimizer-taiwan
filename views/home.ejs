<!-- Hero Section - Dark gradient with floating animation -->
<section class="hero-modern">
  <div class="hero-background">
    <div class="gradient-blob blob-1"></div>
    <div class="gradient-blob blob-2"></div>
    <div class="gradient-blob blob-3"></div>
  </div>
  
  <div class="container hero-content">
    <div class="row align-items-center min-vh-100">
      <div class="col-lg-6" data-aos="fade-up">
        <div class="hero-badge mb-4">
          <i class="bi bi-stars me-2"></i>
          <%= __('home.hero.badge') %>
        </div>
        <h1 class="hero-title mb-4">
          <%= __('home.hero.title') %><br>
          <span class="gradient-text"><%= __('home.hero.titleHighlight') %></span>
        </h1>
        <p class="hero-subtitle mb-5">
          <%= __('home.hero.subtitle') %>
        </p>
        <div class="hero-cta d-flex gap-3">
          <a href="/location" class="btn-modern btn-primary">
            <i class="bi bi-geo-alt me-2"></i>
            <%= __('home.hero.ctaStart') %>
          </a>
          <a href="/crops" class="btn-modern btn-secondary">
            <i class="bi bi-flower2 me-2"></i>
            <%= __('home.hero.ctaBrowse') %>
          </a>
        </div>
      </div>
      
      <div class="col-lg-6" data-aos="fade-left" data-aos-delay="200">
        <div class="hero-image-wrapper">
