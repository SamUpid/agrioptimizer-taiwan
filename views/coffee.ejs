<%
  function scoreColor(s) {
    if (s >= 90) return 'success';
    if (s >= 80) return 'success';
    if (s >= 70) return 'warning';
    return 'secondary';
  }
  function scoreLabel(s) {
    if (s >= 90) return 'Highly Suitable';
    if (s >= 80) return 'Suitable';
    if (s >= 70) return 'Moderate';
    return 'Challenging';
  }
  function resistanceColor(r) {
    if (r === 'high')   return 'success';
    if (r === 'medium') return 'warning';
    return 'danger';
  }
  const zoneLabels = {
    lowland: { en: 'Lowland Hills 低山丘陵', icon: '🌄', color: 'success' },
    mid:     { en: 'Mid-Altitude 中海拔',    icon: '⛰️',  color: 'info'    },
    high:    { en: 'High Mountain 高山',      icon: '🏔️',  color: 'primary' },
    alpine:  { en: 'Alpine Zone 高山帶',      icon: '❄️',  color: 'dark'    }
  };
  const zoneInfo = zoneLabels[zone] || { en: zone, icon: '📍', color: 'secondary' };
%>

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="container mt-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/">Home</a></li>
    <li class="breadcrumb-item"><a href="/location">Location</a></li>
    <li class="breadcrumb-item active">Coffee</li>
  </ol>
</nav>

<div class="container my-4">

  <!-- ── HEADER ─────────────────────────────────────────── -->
  <div class="row mb-4">
    <div class="col-12 text-center">
      <h1 class="display-5 fw-bold text-success">
        <i class="bi bi-cup-hot me-2"></i>Specialty Coffee Varieties
        <span class="d-block fs-5 fw-normal text-muted">精品咖啡品種</span>
      </h1>

      <% if (location && location.address) { %>
        <p class="lead text-muted">Recommendations for <%= location.address %></p>
      <% } %>

      <div class="d-flex justify-content-center flex-wrap gap-2 mt-2">
        <span class="badge bg-secondary fs-6">🏔️ <%= elevation %>m elevation</span>
        <span class="badge bg-<%= zoneInfo.color %> fs-6">
          <%= zoneInfo.icon %> <%= zoneInfo.en %>
        </span>
        <span class="badge bg-warning text-dark fs-6">
          ☕ <%= qualityLabel %>
        </span>
      </div>

      <!-- Save state -->
      <% if (isLoggedIn) { %>
        <div class="mt-3">
          <span class="badge bg-<%= savedCount >= 5 ? 'danger' : 'success' %> fs-6">
            ☕ <%= savedCount %>/5 varieties saved
          </span>
          <% if (savedCount >= 5) { %>
            <div class="alert alert-warning mt-2 d-inline-block px-3 py-1 small">
              ⚠️ Maximum reached — delete one to add another | 已達上限
            </div>
          <% } else { %>
            <span class="text-muted small ms-2"><%= remainingSlots %> slot(s) remaining</span>
          <% } %>
        </div>
      <% } else { %>
        <div class="mt-3">
          <a href="/auth/signup" class="btn btn-outline-success btn-sm">
            💾 Sign up to save your coffee selections
          </a>
        </div>
      <% } %>
    </div>
  </div>

  <!-- ── ELEVATION INFO BOX ─────────────────────────────── -->
  <div class="alert alert-info mb-4">
    <h6 class="alert-heading">
      <i class="bi bi-info-circle me-2"></i>Why Elevation Matters for Coffee
    </h6>
    <p class="mb-0">
      Higher elevations produce slower-ripening cherries with more complex flavours
      and higher acidity — the hallmark of specialty-grade coffee.
      <strong>Your farm: <%= elevation %>m → <%= qualityLabel %></strong>
    </p>
  </div>

  <!-- ── TOP MATCH ──────────────────────────────────────── -->
  <% if (topCoffee) {
       const tc    = topCoffee;
       const sc    = tc.suitabilityScore || 0;
       const color = scoreColor(sc);
       const isSaved = savedCoffeeNames && savedCoffeeNames.includes(tc.coffeeName);
  %>
  <div class="card border-<%= color %> shadow-lg mb-5">
    <div class="card-header bg-<%= color %> text-white">
      <h4 class="mb-0">⭐ Best Match for Your Elevation | 最適合您的品種</h4>
    </div>
    <div class="card-body">
      <div class="row align-items-center">
        <div class="col-md-3 text-center mb-3 mb-md-0">
          <img src="<%= tc.imageUrl || 'https://images.unsplash.com/photo-1447933601403-0c6688de566e?w=400&h=300&fit=crop' %>"
               alt="<%= tc.coffeeName %>"
               class="img-fluid rounded shadow"
               style="max-height:160px; object-fit:cover;">
        </div>
        <div class="col-md-6">
          <h3 class="mb-1"><%= tc.coffeeName %></h3>
          <p class="text-muted mb-2"
             style="font-family:'Noto Sans TC',sans-serif;">
            <%= tc.coffeeNameZh || '' %>
          </p>
          <span class="badge bg-<%= color %> fs-6 mb-2">
            <%= sc %>/100 — <%= scoreLabel(sc) %>
          </span>
          <span class="badge bg-warning text-dark ms-2 mb-2"><%= qualityLabel %></span>

          <% if (tc.optimalElevationMin && tc.optimalElevationMax) { %>
            <p class="mb-1 small">
              <strong>Optimal elevation:</strong>
              <%= tc.optimalElevationMin %>m – <%= tc.optimalElevationMax %>m
            </p>
          <% } %>
          <% if (tc.flavorNotes_en) { %>
            <p class="mb-2 small">
              <strong>Flavour:</strong> <%= tc.flavorNotes_en %>
            </p>
          <% } %>
          <p class="mb-0 small text-muted">
            <i class="bi bi-lightbulb text-warning me-1"></i>
            <%= tc.reason %>
          </p>
        </div>
        <div class="col-md-3 text-center">
          <div class="display-4 fw-bold text-<%= color %> mb-1"><%= sc %></div>
          <p class="text-muted small mb-3">Suitability Score</p>
          <div class="d-flex flex-column gap-2">
            <% if (tc._id) { %>
              <a href="/coffee/<%= tc._id %>" class="btn btn-outline-success btn-sm">
                View Details
              </a>
            <% } %>
            <% if (isLoggedIn) { %>
              <% if (isSaved) { %>
                <button class="btn btn-danger btn-sm"
                        onclick="removeCoffee('<%= tc.coffeeName %>', this)">
                  ✓ Remove
                </button>
              <% } else { %>
                <button class="btn btn-success btn-sm"
                        onclick="saveCoffee('<%= tc.coffeeName %>','<%= tc.coffeeNameZh %>','<%= tc.imageUrl %>','<%= tc.variety %>','<%= tc.altitudeZone %>', this)"
                        <%= savedCount >= 5 ? 'disabled' : '' %>>
                  + Save to Farm
                </button>
              <% } %>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
  <% } %>

  <!-- ── ALL VARIETIES ──────────────────────────────────── -->
  <h3 class="mb-3">
    All Recommended Varieties (<%= coffees.length %>)
    <span class="text-muted fs-6 fw-normal">所有推薦品種</span>
  </h3>

  <div class="row">
    <% coffees.forEach(coffee => {
         const sc     = coffee.suitabilityScore || 0;
         const color  = scoreColor(sc);
         const isSaved = savedCoffeeNames && savedCoffeeNames.includes(coffee.coffeeName);
         const imgSrc = coffee.imageUrl ||
           'https://images.unsplash.com/photo-1447933601403-0c6688de566e?w=400&h=300&fit=crop';
    %>
    <div class="col-md-6 col-lg-4 mb-4">
      <div class="card h-100 shadow-sm border-<%= color %>">

        <img src="<%= imgSrc %>"
             class="card-img-top"
             alt="<%= coffee.coffeeName %>"
             style="height:200px; object-fit:cover;"
             loading="lazy">

        <div class="card-header bg-<%= color %> bg-opacity-10">
          <div class="d-flex justify-content-between align-items-center">
            <h6 class="mb-0"><%= coffee.coffeeName %></h6>
            <span class="badge bg-<%= color %>"><%= sc %>/100</span>
          </div>
        </div>

        <div class="card-body">
          <p class="text-muted small mb-2"
             style="font-family:'Noto Sans TC',sans-serif;">
            <%= coffee.coffeeNameZh || '' %>
            <% if (coffee.variety) { %> · <%= coffee.variety %><% } %>
          </p>

          <span class="badge bg-<%= color %> mb-2"><%= scoreLabel(sc) %></span>

          <!-- Suitability bar -->
          <div class="mb-3">
            <div class="d-flex justify-content-between small text-muted mb-1">
              <span>Altitude suitability 海拔適合度</span>
              <span><%= sc %>%</span>
            </div>
            <div class="progress" style="height:8px;">
              <div class="progress-bar bg-<%= color %>"
                   style="width:<%= sc %>%"
                   role="progressbar"></div>
            </div>
          </div>

          <!-- Why this variety -->
          <p class="small text-muted mb-2">
            <i class="bi bi-lightbulb text-warning me-1"></i>
            <%= coffee.reason || '' %>
          </p>

          <hr class="my-2">

          <!-- DB fields -->
          <div class="row small">
            <% if (coffee.optimalElevationMin && coffee.optimalElevationMax) { %>
            <div class="col-6 mb-1">
              <strong>🏔️ Range</strong><br>
              <%= coffee.optimalElevationMin %>–<%= coffee.optimalElevationMax %>m
            </div>
            <% } %>
            <% if (coffee.yieldPerTree) { %>
            <div class="col-6 mb-1">
              <strong>🌱 Yield</strong><br>
              <%= coffee.yieldPerTree %> kg/tree
            </div>
            <% } %>
            <% if (coffee.cupQualityMin && coffee.cupQualityMax) { %>
            <div class="col-6 mb-1">
              <strong>☕ Cup Score</strong><br>
              <%= coffee.cupQualityMin %>–<%= coffee.cupQualityMax %>
            </div>
            <% } %>
            <% if (coffee.diseaseResistance) { %>
            <div class="col-6 mb-1">
              <strong>🛡️ Disease</strong><br>
              <span class="badge bg-<%= resistanceColor(coffee.diseaseResistance) %>">
                <%= coffee.diseaseResistance %>
              </span>
            </div>
            <% } %>
            <% if (coffee.yearsToFirstHarvest) { %>
            <div class="col-6 mb-1">
              <strong>📅 First harvest</strong><br>
              <%= coffee.yearsToFirstHarvest %> years
            </div>
            <% } %>
            <% if (coffee.processingMethods && coffee.processingMethods.length) { %>
            <div class="col-12 mt-1">
              <strong>⚙️ Processing:</strong>
              <%= coffee.processingMethods.join(', ') %>
            </div>
            <% } %>
          </div>
        </div>

        <div class="card-footer d-flex gap-2">
          <% if (coffee._id) { %>
            <a href="/coffee/<%= coffee._id %>"
               class="btn btn-outline-success btn-sm flex-grow-1">
              Details
            </a>
          <% } %>
          <% if (isLoggedIn) { %>
            <% if (isSaved) { %>
              <button class="btn btn-danger btn-sm flex-grow-1"
                      onclick="removeCoffee('<%= coffee.coffeeName %>', this)">
                ✓ Remove
              </button>
            <% } else { %>
              <button class="btn btn-success btn-sm flex-grow-1"
                      onclick="saveCoffee('<%= coffee.coffeeName %>','<%= coffee.coffeeNameZh %>','<%= coffee.imageUrl %>','<%= coffee.variety %>','<%= coffee.altitudeZone %>', this)"
                      <%= savedCount >= 5 ? 'disabled title="Maximum 5 reached"' : '' %>>
                + Save
              </button>
            <% } %>
          <% } %>
        </div>

      </div>
    </div>
    <% }); %>
  </div>

  <!-- ── INFO CARDS ─────────────────────────────────────── -->
  <div class="row mt-4">
    <div class="col-md-4 mb-3">
      <div class="card h-100 bg-light">
        <div class="card-body">
          <h6 class="fw-bold">🌱 Growing Tips 種植要點</h6>
          <ul class="small mb-0">
            <li>Coffee trees need 3–4 years to first harvest</li>
            <li>Shade trees improve quality and sustainability</li>
            <li>Requires consistent temperature (15–28°C)</li>
            <li>Well-drained, slightly acidic soil (pH 6–6.5)</li>
          </ul>
        </div>
      </div>
    </div>
    <div class="col-md-4 mb-3">
      <div class="card h-100 bg-light">
        <div class="card-body">
          <h6 class="fw-bold">☕ Processing Methods 處理方式</h6>
          <ul class="small mb-0">
            <li><strong>Washed:</strong> Clean, bright acidity</li>
            <li><strong>Natural:</strong> Fruity, full-bodied</li>
            <li><strong>Honey:</strong> Sweet, balanced</li>
            <li><strong>Anaerobic:</strong> Experimental, complex</li>
          </ul>
        </div>
      </div>
    </div>
    <div class="col-md-4 mb-3">
      <div class="card h-100 bg-light">
        <div class="card-body">
          <h6 class="fw-bold">📊 Market Potential 市場潛力</h6>
          <ul class="small mb-0">
            <li>Specialty grade (80+ cup score): Premium prices</li>
            <li>Taiwan's coffee market growing rapidly</li>
            <li>High-elevation coffee fetches best prices</li>
            <li>Geisha variety commands world-class prices</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

</div>