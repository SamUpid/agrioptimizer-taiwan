<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Agricultural decision support system for Taiwanese farmers">
  <title><%= title %> | <%= __('app.name') %></title>
  
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/home-page.css">
  <link rel="stylesheet" href="/css/site-navbar.css">
  <link rel="stylesheet" href="/css/dashboard-page.css">
  <link rel="stylesheet" href="/css/economics-page.css">
  <link rel="stylesheet" href="/css/crops-page.css">
  <link rel="stylesheet" href="/css/coffee-page.css">
  <link rel="stylesheet" href="/css/auth-page.css">
  <link rel="stylesheet" href="/css/location-page.css">
  <link rel="stylesheet" href="/css/climate-page.css">
  <link rel="stylesheet" href="/css/advisor-page.css">
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="<%= page === 'home' ? 'home-page' : page === 'dashboard' ? 'dashboard-page' : page === 'economics' ? 'economics-page' : page === 'crops' ? 'crops-page' : page === 'coffee' ? 'coffee-page' : page === 'login' || page === 'signup' ? 'auth-page' : page === 'location' ? 'location-page' : page === 'climate' ? 'climate-page' : page === 'advisor' ? 'advisor-page' : '' %>">

  <!-- Navigation Bar -->
  <!-- On home page: navbar-light with white bg -->
  <!-- On all other pages: navbar-dark (existing dark theme) -->
  <nav class="navbar navbar-expand-lg sticky-top <%= page === 'home' ? 'navbar-light home-navbar' : 'site-navbar' %>">
    <div class="container">
      <!-- Logo -->
      <a class="navbar-brand d-flex align-items-center" href="/">
        <i class="bi bi-flower3 fs-3 me-2"></i>
        <span class="fw-bold"><%= __('app.name') %></span>
      </a>
      
      <!-- Mobile Toggle -->
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      
      <!-- Navigation Links -->
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto align-items-lg-center">
          <li class="nav-item">
            <a class="nav-link <%= page === 'home' ? 'active' : '' %>" href="/">
              <i class="bi bi-house-door"></i> <%= __('nav.home') %>
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= page === 'location' ? 'active' : '' %>" href="/location">
              <i class="bi bi-geo-alt"></i> <%= __('nav.location') %>
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= page === 'crops' ? 'active' : '' %>" href="/crops">
              <i class="bi bi-flower2"></i> <%= __('nav.crops') %>
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= page === 'coffee' ? 'active' : '' %>" href="/coffee">
              <i class="bi bi-cup-hot"></i> <%= __('nav.coffee') %>
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= page === 'economics' ? 'active' : '' %>" href="/economics">
              <i class="bi bi-calculator"></i> <%= __('nav.economics') %>
            </a>
          </li>
          
          <!-- Language Switcher -->
          <li class="nav-item dropdown ms-lg-3">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
              <i class="bi bi-translate"></i>
              <%= locale === 'zh-TW' ? '中文' : 'English' %>
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
              <li>
                <a class="dropdown-item <%= locale === 'en' ? 'active' : '' %>" href="/language/en">
                  <i class="bi bi-check2 <%= locale === 'en' ? '' : 'invisible' %>"></i> English
                </a>
              </li>
              <li>
                <a class="dropdown-item <%= locale === 'zh-TW' ? 'active' : '' %>" href="/language/zh-TW">
                  <i class="bi bi-check2 <%= locale === 'zh-TW' ? '' : 'invisible' %>"></i> 繁體中文
                </a>
              </li>
            </ul>
          </li>

          <% if (currentUser) { %>
            <li class="nav-item ms-lg-2">
              <a href="/advisor" class="nav-link <%= page === 'advisor' ? 'active' : '' %>">
                <i class="bi bi-robot"></i> Advisor 顧問
              </a>
            </li>
            <li class="nav-item ms-lg-2">
              <a href="/dashboard" class="nav-link">
                <i class="bi bi-grid"></i> Dashboard 儀表板
              </a>
            </li>
            <li class="nav-item ms-lg-2">
              <form action="/auth/logout" method="POST" style="display:inline;">
                <button type="submit" class="btn btn-outline-danger btn-sm">
                  <i class="bi bi-box-arrow-right"></i> Logout 登出
                </button>
              </form>
            </li>
          <% } else { %>
            <% if (page !== 'home') { %>
              <li class="nav-item ms-lg-2">
                <a href="/auth/login" class="btn btn-outline-success btn-sm">
                  Login 登入
                </a>
              </li>
            <% } %>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Flash Messages -->
  <% if (success_msg && success_msg.length > 0) { %>
    <div class="container mt-3">
      <% success_msg.forEach(msg => { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <i class="bi bi-check-circle-fill me-2"></i>
          <%= msg %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% }); %>
    </div>
  <% } %>

  <% if (error_msg && error_msg.length > 0) { %>
    <div class="container mt-3">
      <% error_msg.forEach(msg => { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <i class="bi bi-exclamation-triangle-fill me-2"></i>
          <%= msg %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% }); %>
    </div>
  <% } %>

  <% if (info_msg && info_msg.length > 0) { %>
    <div class="container mt-3">
      <% info_msg.forEach(msg => { %>
        <div class="alert alert-info alert-dismissible fade show" role="alert">
          <i class="bi bi-info-circle-fill me-2"></i>
          <%= msg %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% }); %>
    </div>
  <% } %>

  <!-- Main Content Area -->
  <main>
    <%- body %>
  </main>

  <!-- Footer -->
  <footer class="bg-dark text-white mt-5 py-4">
    <div class="container">
      <div class="row">
        <div class="col-md-6">
          <h5 class="mb-3">
            <i class="bi bi-flower3"></i> <%= __('app.name') %>
          </h5>
          <p class="text-muted">
            <%= __('footer.tagline') %>
          </p>
        </div>
        <div class="col-md-3">
          <h6 class="mb-3"><%= __('footer.quickLinks') %></h6>
          <ul class="list-unstyled">
            <li><a href="/" class="text-muted text-decoration-none"><%= __('nav.home') %></a></li>
            <li><a href="/location" class="text-muted text-decoration-none"><%= __('nav.location') %></a></li>
            <li><a href="/crops" class="text-muted text-decoration-none"><%= __('nav.crops') %></a></li>
          </ul>
        </div>
        <div class="col-md-3">
          <h6 class="mb-3"><%= __('footer.contact') %></h6>
          <p class="text-muted small">
            <i class="bi bi-envelope"></i> support@agrioptimizer.tw<br>
            <i class="bi bi-phone"></i> +886-2-1234-5678
          </p>
        </div>
      </div>
      <hr class="border-secondary">
      <div class="text-center text-muted small">
        &copy; 2026 <%= __('app.name') %>. <%= __('footer.copyright') %>
      </div>
    </div>
  </footer>

  <!-- Bootstrap 5 JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  
  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  
  <!-- Custom JS -->
  <script src="/js/main.js"></script>
  <script src="/js/farm-actions.js"></script>
  <script src="/js/charts.js"></script>
  <script src="/js/advisor.js"></script>
  
  <!-- Page-specific scripts -->
  <%- typeof pageScripts !== 'undefined' ? pageScripts : '' %>

  <!-- Loading Overlay -->
  <div id="loadingOverlay" style="display:none;">
    <div class="spinner-border text-success" role="status">
      <span class="visually-hidden">Loading...</span>
    </div>
  </div>
  <style>
    #loadingOverlay {
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
      background: rgba(255,255,255,0.9);
      z-index: 9999;
      display: flex;
      justify-content: center;
      align-items: center;
    }
  </style>

  <script src="/js/particles.js"></script>

</body>
</html>
